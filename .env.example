# ── Firebase (Auth + Firestore) ─────────────────────────────────────────
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ── Cloudinary (media) ───────────────────────────────────────────────────
# From the Cloudinary console → Settings. The cloud name is the prefix of
# your delivery URLs (e.g. https://res.cloudinary.com/<cloud>/...).
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name

# An *unsigned* upload preset, created in Cloudinary under Settings → Upload →
# Upload presets. Used for the public dish photos — no backend required.
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# Where the signing function lives. Leave blank to auto-detect:
#   *.netlify.app  -> /.netlify/functions/cloudinary
#   *.vercel.app   -> /api/cloudinary
# Set it explicitly for local development, e.g.
#   VITE_CLOUDINARY_FUNCTION_URL=http://localhost:8888/.netlify/functions/cloudinary
VITE_CLOUDINARY_FUNCTION_URL=

# ── Seeding (only needed for `npm run seed`) ─────────────────────────────
# An account whose Firestore users/{uid} document has role: "admin".
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
